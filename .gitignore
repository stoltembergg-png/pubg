# Visual Studio / MSBuild
.vs/
.suo
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.VC.db-shm
*.VC.db-wal
*.opendb
*.opensdf
*.sdf
*.ncb
*.aps

# Build directories
[Bb]uild/
[Bb]uild-*/
[Dd]ebug/
[Rr]elease/
x64/
x86/
out/
ipch/

# MSBuild intermediate files
*.tlog
*.lastbuildstate
*.log
*.obj
*.iobj
*.pdb
*.ipdb
*.ilk
*.idb
*.pch
*.res
*.bsc
*.sbr
*.tmp

# Binaries and libraries
*.exe
*.dll
*.exp
*.lib

# Crash dumps and profiling output
*.dmp
*.pgc
*.pgd
*.cache

# Generated/runtime files
logs.txt
*.userprefs
*.pidb
*.booproj

# Compatibility profiles are small, reproducible build inputs and are
# intentionally versioned. Do not ignore tools/profiles/generated/*.json or
# tools/profiles/generated/profiles_generated.h.

# kdmapper source is versioned; only its local build products are ignored.
tools/kdmapper-src/Intermediate/
tools/kdmapper-src/x64/

# Python bytecode caches from the tooling (profiles/offsets)
__pycache__/
*.pyc

# Local environment and secrets
.env
.env.*
!.env.example

# Ignore vendored directory contents while preserving their placeholders
Lib/**
!Lib/.gitkeep
Include/**
!Include/.gitkeep

# PUBG SDK dumps (gerados, muito grandes - ~100MB - não versionar)
2609.1.1.93/
**/DUMP/
SDK_*.hpp
